# Sao chép thành .env rồi sửa.

# --- Khi chạy bằng docker compose trên VPS ---
# Tên miền đã trỏ bản ghi A về IP của VPS.
DOMAIN=taichinh.example.com

# --- Khi chạy trực tiếp bằng Node (npm start) ---
PORT=3000
# Địa chỉ công khai đầy đủ. Bật cookie Secure và kiểm tra nguồn yêu cầu.
# PUBLIC_URL=https://taichinh.example.com
# Đặt 1 khi chạy sau Caddy/Nginx/Render/Railway để tin header X-Forwarded-*.
# TRUST_PROXY=1
# Thư mục chứa cơ sở dữ liệu và bản sao lưu.
DATA_DIR=data
# Số bản sao lưu hằng ngày giữ lại.
BACKUP_KEEP=14
# Thời hạn đăng nhập (ngày).
SESSION_DAYS=30
